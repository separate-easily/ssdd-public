# ============================================================
# 쏙쏙 분리 똑똑 분리 - 환경 변수 설정
# ============================================================
#
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요.
# .env 파일은 git에 커밋되지 않습니다.

# ============================================================
# Roboflow AI 모델 설정
# ============================================================

# 쓰레기 종류 인식 모델 (YOLO Object Detection)
# - 프로젝트: waste-infad-qk5z1
# - 버전: 2
# - 출력: plastic, paper, vinyl, can, general 등
VITE_WASTE_MODEL_ID=waste-infad-qk5z1/2

# 분리수거함 색상 감지 모델 (ResNet18 Classification)
# - 프로젝트: colors-4b28z
# - 버전: 1
# - 정확도: 97.9%
# - 사용 색상: blue(파랑), yellow(노랑), green(초록), orange(주황), violet(보라)
VITE_BINCOLOR_MODEL_ID=colors-4b28z/1

# Roboflow API 키
# https://app.roboflow.com 에서 발급받으세요
VITE_ROBOFLOW_API_KEY=your_api_key_here

# ============================================================
# 색상 → 분리수거함 매핑 (평택시 기준)
# ============================================================
# 파랑 (blue)   → 플라스틱류 (plastic)
# 노랑 (yellow) → 종이류 (paper)
# 초록 (green)  → 캔 및 병류 (canBotble)
# 주황 (orange) → 비닐류 (vinyl)
# 보라 (violet) → 일반쓰레기 (general)

# ============================================================
# Firebase 설정 (Auth 전용 - Firestore는 사용하지 않음)
# ============================================================
# src/utils/firebase/config.tsx 에서 사용합니다.
# 값을 채우지 않으면 플레이스홀더로 초기화되어 로그인이 동작하지 않습니다.
# Firebase 콘솔(https://console.firebase.google.com) > 프로젝트 설정 > 일반
# 에서 웹 앱 설정값을 확인하세요.

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ============================================================
# Supabase 설정
# ============================================================
# 참고: utils/supabase/info.tsx 에 프로젝트 URL/anon key가 이미 하드코딩되어
# 있어 아래 값은 현재 코드에서 실제로 읽히지 않습니다 (프로젝트: gnqpjcaxyvqsxqfjfalv).

# VITE_SUPABASE_URL=your_supabase_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
